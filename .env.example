# Copy to services/api/.env for local development.
DATABASE_URL=postgres://pesu:pesu@localhost:55432/pesu
REDIS_URL=redis://localhost:56379

LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_KEY=
LIVEKIT_SECRET=

# dev = no SMS, every number accepts DEV_OTP_CODE. Use msg91 in production.
JWT_SECRET=
OTP_PROVIDER=dev
DEV_OTP_CODE=123456
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Firebase service-account key file for push (unset = pushes are only logged). Never commit the file.
FIREBASE_SERVICE_ACCOUNT_PATH=
