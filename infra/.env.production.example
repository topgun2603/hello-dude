# Copy to infra/.env.production and fill in. Never commit the real file.
# Put the Firebase service-account JSON at infra/secrets/firebase-service-account.json.

# Public names (DNS A records → this server). Caddy gets the HTTPS certificates.
API_DOMAIN=api.example.in
ADMIN_DOMAIN=admin.example.in

POSTGRES_PASSWORD=change-me-long-random

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   — keep a safe offline copy: losing it makes every KYC file unreadable
KYC_ENCRYPTION_KEY=

# LiveKit Cloud project
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_KEY=
LIVEKIT_SECRET=
LIVEKIT_POLL=false

# Admin panel sign-in SMS (the app uses Firebase)
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay LIVE keys (test keys are refused in production) + dashboard webhook secret.
# Webhook URL: https://<API_DOMAIN>/v1/webhooks/razorpay
#   events: payment.authorized, payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX payouts to UPI (required in production). Same key id/secret as above.
# Webhook URL: https://<API_DOMAIN>/v1/webhooks/razorpayx
#   events: payout.processed, payout.failed, payout.reversed, payout.rejected
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# KYC files, photos, snapshots: S3 bucket in India (AWS ap-south-1) or Cloudflare R2.
# Leave S3_BUCKET empty to keep encrypted files on the server's kycdata volume.
# R2: S3_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Legal pages (/legal/*)
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_GRIEVANCE_OFFICER_NAME=
LEGAL_GRIEVANCE_EMAIL=
LEGAL_JURISDICTION_CITY=
LEGAL_EFFECTIVE_DATE=
